def solve(board):
    for row in range(8):
        for col in range(8):

            if board[row][col] == 0:

                for num in range(1, 9):

                    # Check row
                    if num in board[row]:
                        continue

                    # Check column
                    if any(board[i][col] == num for i in range(8)):
                        continue

                    # Put number
                    board[row][col] = num

                    if solve(board):
                        return True

                    # Backtrack
                    board[row][col] = 0

                return False

    return True


board = [
    [1,2,3,4,5,6,7,0],
    [5,6,7,8,1,2,3,4],
    [3,4,5,6,7,8,1,2],
    [7,8,1,2,3,4,5,6],
    [2,3,4,5,6,7,8,1],
    [6,7,8,1,2,3,4,5],
    [4,5,6,7,8,1,2,3],
    [8,1,2,3,4,5,6,7]
]

print("Before solving:")
for row in board:
    print(row)

solve(board)

print("\nAfter solving:")
for row in board:
    print(row)
